# Copy to .env and fill in the values
PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/social-media-api

# Use long random strings, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Comma-separated list of allowed frontend origins (HTTP and Socket.IO)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: enables multi-instance Socket.IO, shared rate limits and caching
# REDIS_URL=redis://localhost:6379

# Max auth requests per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20

# Gmail address and app password; emails are skipped when empty
EMAIL=
PASSWORD=

# Block posting and commenting until the email is verified
REQUIRE_EMAIL_VERIFICATION=false

# Used in password reset and verification links
FRONTEND_URL=http://localhost:3000
